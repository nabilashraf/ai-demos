# Optional: enable OpenAI embeddings + chat. Without this, local hash/TF embeddings and extractive answers are used.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
# Top-k chunks to retrieve
RAG_TOP_K=3
# Chunk size (characters) and overlap
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
PORT=3847
